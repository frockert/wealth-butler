# Wealth Butler — server env (copy to .env, never commit .env)

# Optional: AI CSV fallback + market summary on sync
ANTHROPIC_API_KEY=

# USD → AUD conversion for IBKR USD positions
USD_TO_AUD=1.55

# --- IBKR Flex Query (recommended MVP) ---
# Token: IB Account Management → Settings → Configure Flex Web Service
# Query IDs: Reports → Flex Queries → Open Positions (CSV), one per account
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID_BUSINESS=
IBKR_FLEX_QUERY_ID_PERSONAL=

# --- IBKR Client Portal Gateway (alternative) ---
# Run gateway locally; authenticate at https://localhost:5000 first
IBKR_GATEWAY_URL=http://localhost:5000/v1/api
IBKR_ACCOUNT_ID_BUSINESS=
IBKR_ACCOUNT_ID_PERSONAL=

# --- Coinspot (optional — or connect via + Asset modal) ---
COINSPOT_API_KEY=
COINSPOT_API_SECRET=
